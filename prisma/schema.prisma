generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  staff         Staff[]
  services      Service[]
  appointments  Appointment[]
  activityLogs  ActivityLog[]

  @@map("users")
}

model RefreshToken {
  id          String   @id @default(uuid())
  token       String   @unique
  userId      String   @map("user_id")
  deviceInfo  String?  @map("device_info")
  expiresAt   DateTime @map("expires_at")
  isRevoked   Boolean  @default(false) @map("is_revoked")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

enum StaffStatus {
  AVAILABLE
  ON_LEAVE
}

model Staff {
  id             String      @id @default(uuid())
  userId         String      @map("user_id")
  name           String
  serviceType    String      @map("service_type")
  dailyCapacity  Int         @default(5) @map("daily_capacity")
  status         StaffStatus @default(AVAILABLE)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  activityLogs ActivityLog[]

  @@index([userId])
  @@index([serviceType])
  @@index([status])
  @@map("staff")
}

enum ServiceDuration {
  FIFTEEN_MINUTES
  THIRTY_MINUTES
  SIXTY_MINUTES
}

model Service {
  id                 String          @id @default(uuid())
  userId             String          @map("user_id")
  name               String
  duration           ServiceDuration
  requiredStaffType  String          @map("required_staff_type")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([userId])
  @@index([requiredStaffType])
  @@map("services")
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
  IN_QUEUE
}

model Appointment {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  customerName    String            @map("customer_name")
  serviceId       String            @map("service_id")
  staffId         String?           @map("staff_id")
  appointmentDate DateTime          @map("appointment_date") @db.Date
  appointmentTime String            @map("appointment_time")
  duration        Int
  status          AppointmentStatus @default(SCHEDULED)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff        Staff?        @relation(fields: [staffId], references: [id], onDelete: SetNull)
  queue        QueueEntry?
  activityLogs ActivityLog[]

  @@index([userId])
  @@index([staffId])
  @@index([appointmentDate])
  @@index([status])
  @@index([appointmentDate, appointmentTime])
  @@index([staffId, appointmentDate, appointmentTime])
  @@map("appointments")
}

model QueueEntry {
  id            String   @id @default(uuid())
  appointmentId String   @unique @map("appointment_id")
  queuePosition Int      @map("queue_position")
  addedAt       DateTime @default(now()) @map("added_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([queuePosition])
  @@index([addedAt])
  @@map("queue_entries")
}

enum ActivityType {
  APPOINTMENT_CREATED
  APPOINTMENT_ASSIGNED
  APPOINTMENT_UPDATED
  APPOINTMENT_CANCELLED
  QUEUE_ADDED
  QUEUE_ASSIGNED
  STAFF_CREATED
  STAFF_UPDATED
  SERVICE_CREATED
}

model ActivityLog {
  id              String       @id @default(uuid())
  userId          String       @map("user_id")
  actionType      ActivityType @map("action_type")
  description     String
  appointmentId   String?      @map("appointment_id")
  staffId         String?      @map("staff_id")
  createdAt       DateTime     @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  staff       Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([actionType])
  @@map("activity_logs")
}